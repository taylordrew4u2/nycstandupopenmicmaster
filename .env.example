# Copy to .env for local Docker use. Never commit a populated .env file.
# Supply a unique password of at least 15 characters.
ADMIN_PASSWORD=
DATABASE_PATH=./data/miclist.sqlite3
SCHEDULER_ENABLED=1
GEOCODING_ENABLED=1
# 1 is for HTTP localhost only. Production HTTPS must use 0.
LOCAL_DEV=1
# Production example: PUBLIC_ORIGIN=https://your-site.example
PUBLIC_ORIGIN=
