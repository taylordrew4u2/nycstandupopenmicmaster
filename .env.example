# Copy to .env for local Docker use. Never commit a populated .env file.
# Supply a unique password of at least 15 characters.
ADMIN_PASSWORD=
DATABASE_PATH=./data/miclist.sqlite3
# Vercel requires a hosted PostgreSQL URL. Keep the actual value private.
DATABASE_URL=
# Enable the repository's authenticated GitHub Actions source checks on Vercel.
GITHUB_SYNC_ENABLED=0
# Optional alternative for an external scheduler: unique random value, 32+ characters.
CRON_SECRET=
SCHEDULER_ENABLED=1
GEOCODING_ENABLED=1
# 1 is for HTTP localhost only. Production HTTPS must use 0.
LOCAL_DEV=1
# Production example: PUBLIC_ORIGIN=https://your-site.example
PUBLIC_ORIGIN=
